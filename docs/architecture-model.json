  "accessibility": {
    "title": "OpenBound ownership and evidence boundaries",
    "description": "One agent owns the task. Private sources are adapted into an isolated public candidate. Inspector and verification produce private evidence. Only the candidate crosses the host-authorized external delivery boundary."
